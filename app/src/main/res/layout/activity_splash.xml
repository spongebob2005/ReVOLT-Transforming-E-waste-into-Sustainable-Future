<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_full"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:id="@+id/logoPlate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_logo_plate"
        android:elevation="6dp"
        android:padding="20dp">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="97dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/input_logo" />
    </FrameLayout>

    <TextView
        android:id="@+id/slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/splash_slogan"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/on_hero" />
</LinearLayout>
