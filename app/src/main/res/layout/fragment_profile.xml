<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_avatar"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/on_primary_container"
                android:textSize="32sp"
                tools:text="SS" />

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.ReVOLT.Headline"
                tools:text="Sameeran Shinde" />

            <TextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.ReVOLT.Body"
                tools:text="sameeran@example.com" />

            <TextView
                android:id="@+id/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ReVOLT.Body"
                tools:text="9876543210" />

            <com.google.android.material.chip.Chip
                android:id="@+id/memberSince"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="false"
                app:chipBackgroundColor="@color/primary_container"
                app:chipIcon="@drawable/ic_eco"
                app:chipIconTint="@color/on_primary_container"
                app:chipStrokeWidth="0dp"
                android:textColor="@color/on_primary_container"
                tools:text="Member since Oct 2026" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/profile_impact"
            android:textAppearance="@style/TextAppearance.ReVOLT.Section" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="6dp">

                <include
                    android:id="@+id/statCompleted"
                    layout="@layout/view_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statDevices"
                    layout="@layout/view_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statKg"
                    layout="@layout/view_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/profile_settings"
            android:textAppearance="@style/TextAppearance.ReVOLT.Section" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowServer"
                    layout="@layout/view_profile_row" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/outline_variant"
                    app:dividerInsetStart="60dp" />

                <include
                    android:id="@+id/rowAbout"
                    layout="@layout/view_profile_row" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/outline_variant"
                    app:dividerInsetStart="60dp" />

                <include
                    android:id="@+id/rowLogout"
                    layout="@layout/view_profile_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.ReVOLT.Label"
            tools:text="Version 2.0" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
